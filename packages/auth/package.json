{
  "name": "@guardrail/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "auth:generate": "better-auth generate --config src/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@guardrail/db": "workspace:*",
    "@guardrail/registry": "workspace:*",
    "better-auth": "^1.3.0",
    "autumn-js": "^0.1.30",
    "@guardrail/env": "workspace:*"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.7.0"
  }
}
